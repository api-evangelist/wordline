          "name": "Retrieve authorizations",
          "request": {
            "name": "Retrieve authorizations",
            "description": {
              "content": "This operation uses the unique AcquirerRefNo (acquirerReferenceNumber ARN) to retrieve the associated authorization(s) data. \nIf there is a previous and/or next page the http response header will have a link (url) to this data. See https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Link#pagination_through_links\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "acquiring",
                "transaction",
                "v2.0",
                "acquirers",
                ":acquirerId",
                "authorizations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "acquirerRefNo",
                  "value": "<string>",
                  "description": "(Required) Data supplied by an acquirer to assist in identifying an authorization.\n(Note: acquirerRefNo = acquirerReferenceNumber)\n\nexamples ARN29851, 74875009071000046650752\n"
                },
                {
                  "disabled": false,
                  "key": "transactionAmountFrom",
                  "value": "<int32>",
                  "description": "Transaction amount (whole units), amount should be greater than or equal to this value"
                },
                {
                  "disabled": false,
                  "key": "transactionAmountTo",
                  "value": "<int32>",
                  "description": "Transaction amount (whole units), amount should be less than this value"
                },
                {
                  "disabled": false,
                  "key": "transactionAmountCurrency",
                  "value": "<string>",
                  "description": "Transaction amount currency, according to ISO 4217. Required if search amount is available. Example EUR"
                },
                {
                  "disabled": false,
                  "key": "sortField",
                  "value": "<string>",
                  "description": "Sort field"
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "<string>",
                  "description": "Sort order"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<string>",
                  "description": "Page size (max 300)"
                },
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "<string>",
                  "description": "Page number"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "acquirerId",
                  "description": "(Required) Unique identification of the acquirer, determined by equensWorldline"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",

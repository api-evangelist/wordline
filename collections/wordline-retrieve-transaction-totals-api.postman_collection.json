        {
          "id": "b7543d44-b648-4853-9061-a4d252ba8865",
          "name": "Retrieve daily totals",
          "request": {
            "name": "Retrieve daily totals",
            "description": {
              "content": "This operation of the Analysis API will help you to retrieve daily aggregated totals.\nYou can do this using by providing an entity from the equensWorldline contract hierarchy, such as a contractId. \nThe results are aggregated transaction numbers and revenue on a daily basis, divided by type Purchases, refunds and chargebacks.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "analysis",
                "totals",
                "day",
                "levelid",
                ":levelId",
                "levelidvalue",
                ":levelIdValue"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Transaction type Filter. \nValues (optional):\npurchase, refund or chargeback\n"
                },
                {
                  "disabled": false,
                  "key": "begin",
                  "value": "<string>",
                  "description": "(Required) Start day (yyyymmdd)\n"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "(Required) End day (yyyymmdd)\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "levelId",
                  "description": "(Required) Any ID of a level of the Equens contract administration"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "levelIdValue",
                  "description": "(Required) ID value at this level.\nExample value\nclusterId 1000,\nmerchantId 2000,\ncontractId 3000,\nsiteId 4000,\nterminalId 5000\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

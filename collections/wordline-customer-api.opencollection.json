          "info": {
            "name": "Create Contact for a customer by external reference (beta)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/issuers/:issuerId/customers/external-customers/:issuerCustomerExternalReference/contacts",

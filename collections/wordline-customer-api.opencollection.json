        {
          "info": {
            "name": "Create Contact for a customer (beta)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/issuers/:issuerId/customers/:customerReference/contacts",
            "headers": [

                "description": "Issuer ID"
              },
              {
                "name": "issuerCardExternalReference",
                "value": "",
                "type": "path",
                "description": "issuerCardExternalReference"
              }
            ]
          },
          "docs": "Validate the CVV by external reference"
        }
      ]
    }
  ],
  "bundled": true

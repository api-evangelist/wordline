            "method": "GET",
            "url": "{{baseUrl}}/issuers/:issuerId/accounts/external-accounts/:issuerAccountExternalReference/account-future-updates",
            "headers": [
              {
                "name": "WL-Correlation-ID",
                "value": ""
              },

  "items": [
    {
      "info": {
        "name": "Card - Pin Try Counter",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Reset Pin Try Counter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/issuers/:issuerId/cards/:cardReference/reset-pin-try-counter",
            "headers": [
              {
                "name": "WL-Correlation-ID",
                "value": ""
              },
              {
                "name": "WL-Username",
                "value": ""
              },
              {
                "name": "WL-Peer-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filtered Fields"
              },
              {
                "name": "issuerId",
                "value": "",
                "type": "path",
                "description": "Issuer ID"
              },
              {
                "name": "cardReference",
                "value": "",
                "type": "path",
                "description": "cardReference"
              }
            ]
          },
          "docs": "This API enables the issuer to reset the PIN try Counter value.\nA control related to this counter value ((MAX Pin try) can be performed during the authorization processing if configured."
        },
        {
          "info": {
            "name": "Reset Pin Try Counter by external reference",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/issuers/:issuerId/cards/external-cards/:issuerCardExternalReference/reset-pin-try-counter",
            "headers": [
              {
                "name": "WL-Correlation-ID",
                "value": ""
              },
              {
                "name": "WL-Username",
                "value": ""
              },
              {
                "name": "WL-Peer-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filtered Fields"
              },
              {
                "name": "issuerId",
                "value": "",
                "type": "path",
                "description": "Issuer ID"
              },
              {
                "name": "issuerCardExternalReference",
                "value": "",
                "type": "path",
                "description": "issuerCardExternalReference"
              }
            ]
          },
          "docs": "This API enables the issuer to reset the PIN try Counter value.\nA control related to this counter value ((MAX Pin try) can be performed during the authorization processing if configured."
        }
      ]
    }
  ],

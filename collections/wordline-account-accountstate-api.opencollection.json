            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/issuers/:issuerId/accounts/:accountReference/account-states",
            "headers": [
              {
                "name": "WL-Correlation-ID",
                "value": ""
              },
              {
                "name": "WL-Peer-ID",
                "value": ""
              },
              {
                "name": "WL-Username",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountReference",
                "value": "",
                "type": "path",
                "description": "accountReference"
              },
              {
                "name": "issuerId",
                "value": "",
                "type": "path",
                "description": "issuerId"
              },
              {
                "name": "rank",
                "value": "",
                "type": "query",
                "description": "rank"
              }
            ]
          },
          "docs": "Retrieves the current effective state details of a specific account based on the provided account reference"
        }
      ]
    }
  ],
  "bundled": true
}